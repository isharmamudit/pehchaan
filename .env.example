# ---- Browser (safe to expose; no API keys here) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ---- Server secrets (edge functions only; NEVER prefixed with VITE_) ----
# supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=... GOOGLE_API_KEY=...
GEMINI_API_KEY=
# Set to the current Gemini Flash model name. Not hardcoded anywhere in the code.
GEMINI_MODEL=gemini-3.8-flash
# One Google Cloud key with BOTH "Safe Browsing API" and "Fact Check Tools API" enabled.
GOOGLE_API_KEY=
# Comma-separated list of allowed browser origins for CORS.
ALLOWED_ORIGIN=http://localhost:5173
